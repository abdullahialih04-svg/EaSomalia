
{
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/:slug.html",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/pages/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/connect",
      "destination": "/pages/connect.html"
    },
    {
      "source": "/ea-fellowship",
      "destination": "/pages/ea-fellowship.html"
    },
    {
      "source": "/effective-giving",
      "destination": "/pages/effective-giving.html"
    },
    {
      "source": "/incubation",
      "destination": "/pages/incubation.html"
    },
    {
      "source": "/jobs",
      "destination": "/pages/jobs.html"
    },
    {
      "source": "/ai-safety-governance-fellowship",
      "destination": "/pages/ai-safety-governance-fellowship.html"
    },
    {
      "source": "/animal-welfare-fellowship",
      "destination": "/pages/animal-welfare-fellowship.html"
    },
    {
      "source": "/global-health-fellowship",
      "destination": "/pages/global-health-fellowship.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
